# Шаблон .env для docker-compose.yml: скопировать в .env и раскомментировать нужное.
# Сам .env в git не попадает (.gitignore). Здесь только плейсхолдеры: паролей, адресов
# контура и других секретов в этом файле нет и быть не должно — их место в секретах
# развёртывания.
#
# Строка закомментирована — действует умолчание: для переменных сервиса — из
# src/main/resources/application.yml (оно ведёт на локальный контур этого compose),
# для аргументов сборки — из ARG в Dockerfile. У паролей (DB_PASSWORD, RABBITMQ_PASSWORD)
# умолчаний нет: вне compose их задают всегда. Адрес и пароли базы и брокера для профиля
# app compose подменяет сам (DB_URL, DB_PASSWORD, RABBITMQ_HOST, RABBITMQ_PASSWORD,
# RABBITMQ_SSL_ENABLED=false): внутри его сети localhost — это сам контейнер. Профиль
# stand .env как переменные сервиса не читает, только аргументы сборки образа.

# --- База (переменные сервиса) ------------------------------------------------------
# DB_URL=<jdbc:postgresql://хост:порт/база>
# DB_USERNAME=<пользователь базы>
# DB_PASSWORD=<пароль базы — из секретов развёртывания; умолчания нет>
# Параметры драйвера, общие для пула и миграций (sslmode, sslrootcert …), — только
# в DB_URL: у Liquibase своё соединение, настройки пула до него не доходят.
# Таймауты соединений пула приложения; миграций они не касаются. Значения — с единицами
# PostgreSQL (ms, s, min); 0 — без ограничения. Умолчания: 5s, 30s, 1min.
# Единицу писать всегда: число без неё PostgreSQL читает как миллисекунды,
# и «30» вместо «30s» молча отменяет почти каждый запрос.
# DB_LOCK_TIMEOUT=<ожидание одной блокировки, например 5s>
# DB_STATEMENT_TIMEOUT=<один оператор, например 30s; меньше DB_SOCKET_TIMEOUT_SECONDS>
# DB_IDLE_IN_TRANSACTION_TIMEOUT=<открытая транзакция без запросов, например 1min>
# Таймаут чтения сокета драйвером, целые секунды, умолчание 60. Обязан быть больше
# DB_STATEMENT_TIMEOUT: иначе соединение рвётся раньше, чем сервер отменит оператор.
# DB_SOCKET_TIMEOUT_SECONDS=<секунды>

# --- Брокер 1С:УСК (переменные сервиса) ---------------------------------------------
# RABBITMQ_HOST=<хост брокера>
# RABBITMQ_PORT=<5672 без TLS | 5671 с TLS>
# RABBITMQ_VHOST=<vhost>
# RABBITMQ_USERNAME=<логин брокера>
# RABBITMQ_PASSWORD=<пароль брокера — из секретов развёртывания; умолчания нет>
# RABBITMQ_SSL_ENABLED=<true | false>
# Проверка сертификата брокера и имени хоста в нём, умолчание true: центр сертификации —
# в certs/ (Dockerfile), имя хоста — в сертификате. Тестовый контур (самоподписанный
# сертификат без имени хоста) выключает её явно: VALIDATE_CERTIFICATE=false; имя без
# проверки сертификата не сверяется.
# RABBITMQ_SSL_VALIDATE_CERTIFICATE=<true | false>
# RABBITMQ_SSL_VERIFY_HOSTNAME=<true | false>
# Слушатели очередей 1С. В application.yml умолчание true; локальный брокер очередей 1С
# не знает, поэтому для профиля app compose подставляет false, пока здесь не задано
# иначе. Вне compose (./gradlew bootRun против этого брокера) — задать false явно.
RABBITMQ_LISTENER_AUTO_STARTUP=false

# --- Очереди 1С:УСК (переменные сервиса) --------------------------------------------
# Умолчания в application.yml сняты со списка очередей брокера; менять — только
# сверившись со списком брокера нового контура, а не с ТЗ.
# ONEC_QUEUE_POLICIES=<имя очереди ТЗ-1>
# ONEC_QUEUE_INSURANCE_CONTRACTS=<имя очереди ТЗ-2>
# ONEC_QUEUE_CONTRAGENTS=<имя очереди ТЗ-3>
# ONEC_QUEUE_MKB10=<имя очереди ТЗ-4>
# ONEC_QUEUE_LPU_CONTRACTS=<имя очереди ТЗ-5>
# ONEC_QUEUE_PROGRAMS=<имя очереди ТЗ-6>
# ONEC_QUEUE_APPEAL_TYPES=<имя очереди ТЗ-7>
# ONEC_QUEUE_LPU_CONTACTS=<имя очереди ТЗ-8>
# ONEC_QUEUE_PRICE_LISTS=<имя очереди ТЗ-9, пакеты строк>
# ONEC_QUEUE_PRICE_LISTS_FINAL=<имя очереди ТЗ-9, финальное сообщение>
# ONEC_QUEUE_CONTRAGENT_SERVICES=<имя очереди ТЗ-10>

# --- Сборка образа (аргументы Dockerfile, профили app и stand) ---------------------
# Откуда jar: build — собрать в образе (умолчание), host — взять из build/libs
# после ./gradlew clean bootJar (в облачной сессии — только host: контейнеры без сети).
# JAR_SOURCE=<build | host>
# Репозитории зависимостей при JAR_SOURCE=build: false — Nexus контура, true — Maven Central.
# PUBLIC_REPOSITORIES=<true | false>
# Базовые образы; в облачной сессии — через mirror.gcr.io/library/, в контуре — из Nexus.
# JDK_IMAGE=<реестр/eclipse-temurin:21.0.12.1_1-jdk>
# JRE_IMAGE=<реестр/eclipse-temurin:21.0.12.1_1-jre>
# Дистрибутив Gradle при JAR_SOURCE=build; пусто — адрес из gradle-wrapper.properties.
# Зеркало обязано отдать тот же zip: обёртка сверяет его с distributionSha256Sum.
# GRADLE_DISTRIBUTION_URL=<адрес gradle-8.14.3-bin.zip в зеркале>
