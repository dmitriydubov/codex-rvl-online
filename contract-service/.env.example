# Шаблон .env для docker-compose.yml: скопировать в .env и раскомментировать нужное.
# Сам .env в git не попадает (.gitignore). Здесь только плейсхолдеры: паролей, адресов
# контура и других секретов в этом файле нет и быть не должно — их место в секретах
# развёртывания.
#
# Строка закомментирована — действует умолчание: для переменных сервиса — из
# src/main/resources/application.yml (оно ведёт на локальный контур этого compose),
# для аргументов сборки — из ARG в Dockerfile. У пароля базы (DB_PASSWORD) умолчания
# нет: вне compose его задают всегда. Адрес и пароль базы для профиля app compose
# подменяет сам (DB_URL, DB_PASSWORD): внутри его сети localhost — это сам контейнер.

# --- База (переменные сервиса) ------------------------------------------------------
# DB_URL=<jdbc:postgresql://хост:порт/база?logServerErrorDetail=false>
# DB_USERNAME=<пользователь базы>
# DB_PASSWORD=<пароль базы — из секретов развёртывания; умолчания нет>
# Параметры драйвера, общие для пула и миграций (sslmode, sslrootcert …), — только
# в DB_URL: у Liquibase своё соединение, настройки пула до него не доходят.
# logServerErrorDetail=false в DB_URL обязателен: без него драйвер PostgreSQL дописывает
# в текст ошибки значения строки, в том числе персональные данные сторон договора.
# Ожидание свободного соединения пула, миллисекунды, умолчание 2000; меньше 250 пул не принимает.
# DB_CONNECTION_TIMEOUT_MS=<миллисекунды>
# Таймауты соединений пула приложения; миграций они не касаются. Значения — с единицами
# PostgreSQL (ms, s, min); 0 — без ограничения. Умолчания: 5s, 30s, 1min.
# Единицу писать всегда: число без неё PostgreSQL читает как миллисекунды,
# и «30» вместо «30s» молча отменяет почти каждый запрос.
# DB_LOCK_TIMEOUT=<ожидание одной блокировки, например 5s>
# DB_STATEMENT_TIMEOUT=<один оператор, например 30s; меньше DB_SOCKET_TIMEOUT_SECONDS>
# DB_IDLE_IN_TRANSACTION_TIMEOUT=<открытая транзакция без запросов, например 1min>
# Таймаут чтения сокета драйвером, целые секунды, умолчание 60. Обязан быть больше
# DB_STATEMENT_TIMEOUT: иначе соединение рвётся раньше, чем сервер отменит оператор.
# DB_SOCKET_TIMEOUT_SECONDS=<секунды>

# --- Доступ к контуру с других машин (переменные docker-compose.yml) -------------------
# Адрес, на котором compose публикует порт API сервиса (8080) и базы (5432); умолчание
# 127.0.0.1 — только эта машина. 0.0.0.0 — вся сеть: пароль базы в compose известен всем,
# поэтому, открывая базу, смените его; порты откройте в брандмауэре. Актуатор всегда
# остаётся на 127.0.0.1.
# SERVICE_BIND_ADDRESS=<127.0.0.1 | 0.0.0.0>
# POSTGRES_BIND_ADDRESS=<127.0.0.1 | 0.0.0.0>

# --- Порт актуатора (переменная сервиса) ------------------------------------------
# Порт /actuator/health, /actuator/info и /actuator/prometheus, умолчание 8081; на порту API (8080) актуатора
# нет. Пробы Kubernetes — /livez и /readyz на порту API. Профиль app публикует этот же
# порт на 127.0.0.1.
# MANAGEMENT_PORT=<порт>

# --- Сборка образа (аргументы Dockerfile, профиль app) -----------------------------
# Откуда jar: build — собрать в образе (умолчание), host — взять из build/libs
# после ./gradlew clean bootJar.
# JAR_SOURCE=<build | host>
# Репозитории зависимостей при JAR_SOURCE=build: false — Nexus контура, true — Maven Central.
# PUBLIC_REPOSITORIES=<true | false>
# Базовые образы; в контуре — из Nexus.
# JDK_IMAGE=<реестр/eclipse-temurin:21.0.12.1_1-jdk>
# JRE_IMAGE=<реестр/eclipse-temurin:21.0.12.1_1-jre>
# Дистрибутив Gradle при JAR_SOURCE=build; пусто — адрес из gradle-wrapper.properties.
# Зеркало обязано отдать тот же zip: обёртка сверяет его с distributionSha256Sum.
# Полный https-адрес zip-файла в зеркале, не имя образа gradle; именно -bin.zip — обёртка сверяет его
# с distributionSha256Sum. Одной строкой, без угловых скобок и без повтора имени переменной в значении.
# GRADLE_DISTRIBUTION_URL=https://<зеркало>/gradle-8.14.3-bin.zip
