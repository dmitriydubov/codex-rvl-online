# Шаблон .env для docker-compose.yml: скопировать в .env и раскомментировать нужное.
# Только плейсхолдеры: пароли и адреса контура хранятся в секретах развёртывания, а не в git.
# Закомментированная строка — действует умолчание из application.yml или Dockerfile.
# Адреса и пароли базы и брокеров для профиля app compose подменяет сам: внутри его сети localhost —
# это сам контейнер.

# --- База (переменные сервиса) ------------------------------------------------------
# Пароль обязателен вне compose: известное умолчание подошло бы к любой базе с таким паролем.
# Параметры драйвера для пула и миграций (sslmode и т. п.) — только в DB_URL: у миграций своё соединение.
# logServerErrorDetail=false в DB_URL обязателен: иначе ошибка базы несёт значения строки, то есть персональные данные.
# DB_URL=<jdbc:postgresql://хост:порт/база?logServerErrorDetail=false>
# DB_USERNAME=<пользователь базы>
# DB_PASSWORD=<пароль базы>
# DB_CONNECTION_TIMEOUT_MS=<ожидание соединения пула, миллисекунды; не меньше 250>
# Таймауты сеанса пула пишутся с единицей PostgreSQL (ms, s, min): число без неё читается как миллисекунды,
# и «30» вместо «30s» отменит почти каждый запрос.
# DB_LOCK_TIMEOUT=<например 5s>
# DB_STATEMENT_TIMEOUT=<например 30s>
# DB_IDLE_IN_TRANSACTION_TIMEOUT=<например 1min>
# Больше DB_STATEMENT_TIMEOUT: иначе соединение рвётся раньше, чем сервер отменит оператор.
# DB_SOCKET_TIMEOUT_SECONDS=<секунды>

# --- Сервис справочных данных, data-reference (переменные сервиса) --------------------
# Адрес внутреннего API справочников вместе с базовым путём, без слэша на конце. Обязателен вне compose, умолчания
# нет: адрес локального контура data-reference — http://localhost:8080/internal/v1; для профиля app compose
# подставляет адрес его стенда по его сети (http://data-reference-stand:8080/internal/v1; сервис профиля app того же
# compose — http://data-reference:8080/internal/v1).
# REFERENCE_URL=<http://хост:порт/internal/v1>
# REFERENCE_CONNECT_TIMEOUT=<например 2s>
# Не меньше 7s: худший ответ справочника при отказе его базы — около 5 с.
# REFERENCE_READ_TIMEOUT=<например 7s>
# Повторы одного чтения при 503, таймауте и неожиданном ответе; 0 — без повторов.
# REFERENCE_MAX_RETRIES=<число повторов после первой неудачи>
# REFERENCE_RETRY_DELAY=<пауза между попытками, например 1s>

# --- Хранилище S3 справок 070/у (переменные сервиса) --------------------------------------------
# Адрес S3 со схемой и портом, без слэша на конце; бакет заводится заранее, сервис его не создаёт. Обязательны,
# умолчаний нет. Ключи доступа — только отсюда или из секрета окружения.
# S3_ENDPOINT=<https://хост:порт>
# S3_BUCKET=<имя бакета>
# S3_ACCESS_KEY=<ключ доступа>
# S3_SECRET_KEY=<секретный ключ>
# S3_REGION=<например us-east-1>
# ИНН (10 цифр) и КПП (9 цифр) организации — начало ключа объекта; умолчания 0000000000 и 000000000 — заглушки.
# S3_INN=<ИНН организации>
# S3_KPP=<КПП организации>
# Папка справок без слэшей по краям; ключ объекта — {ИНН}_{КПП}/{base-path}/{uuid}/{вложение}.{jpg|png|pdf}.
# S3_BASE_PATH=<например certificates>
# Имя набора SSL Spring Boot с сертификатом внутреннего УЦ; пусто — доверие JVM. Сам набор:
# SPRING_SSL_BUNDLE_PEM_STORAGE_TRUSTSTORE_CERTIFICATE=file:/путь/к/ca.pem
# S3_SSL_BUNDLE=<например storage>
# Таймауты; предел всего вызова меньше 30 с, которые ждёт ответа сервис Заявок.
# S3_CONNECT_TIMEOUT=<например 2s>
# S3_READ_TIMEOUT=<например 10s>
# S3_WRITE_TIMEOUT=<например 10s>
# S3_CALL_TIMEOUT=<например 20s>
# Наибольший размер файла справки, не больше 10MB.
# ATTACHMENT_MAX_FILE_SIZE=<например 5MB>

# --- Журнал входящих сообщений сервиса Заявок и нумерация договоров (переменные сервиса) ------
# Пауза между проходами обработчика журнала и размер пачки одного прохода.
# INBOX_PROCESSING_INTERVAL=<например 10s>
# INBOX_PROCESSING_BATCH_SIZE=<число сообщений>
# Паузы перед повторами после временного отказа базы, через запятую; число пауз — число повторов, после последней
# сообщение отклоняется окончательно.
# INBOX_RETRY_BACKOFF=<например 1m,5m,15m>
# Через сколько после приёма стирается тело сообщения с персональными данными; запись с исходом остаётся.
# INBOX_PAYLOAD_RETENTION=<например 30d>
# INBOX_RETENTION_INTERVAL=<например 1h>
# INBOX_RETENTION_BATCH_SIZE=<число тел в одной транзакции>
# При недоступной базе приём из очередей обоих брокеров встаёт на паузу: как часто проверять доступность журнала
# входящих, чтобы вернуть потребителей, и сколько ждать остановки потребителей перед повторным запуском.
# INBOX_STORAGE_CHECK_INTERVAL=<например 10s>
# INBOX_CONSUMER_STOP_TIMEOUT=<например 30s>
# Пауза перед возвратом в очередь сообщения, доставка которого столкнулась с одновременной доставкой того же message_id.
# INBOX_DUPLICATE_DELIVERY_BACKOFF=<например 5s>
# Срок строки блокировки ведущего экземпляра: столько после гибели ведущего роль ждёт перехода к другому экземпляру;
# строго больше сердцебиения (1 с).
# LEADER_LOCK_TTL=<например 30s>
# Соединения отдельного пула блокировки ведущего (настройки основного пула, но lock_timeout выключен; сеансы видны в
# pg_stat_activity под application_name contract-service-leader-lock): продление роли не ждёт свободного соединения
# основного пула и не упирается в его таймаут блокировки. Хватает одного.
# DB_LEADER_POOL_SIZE=<например 1>
# Часовой пояс, по которому берётся год в номере договора КМ.
# CONTRACT_NUMBERING_ZONE=<например Europe/Moscow>
# Пауза между проходами, которые готовят запросы на выпуск полисов ЛМ в 1С:УСК, и размер пачки одного прохода.
# Проход читает справочники у data-reference и при его недоступности откладывает остаток до следующего прохода.
# LM_POLICY_REQUEST_INTERVAL=<например 10s>
# LM_POLICY_REQUEST_BATCH_SIZE=<число полисов>
# Пауза между пересчётами сводки полисов ЛМ, ждущих ответа 1С:УСК, и порог, после которого полис считается
# просроченным (метрика contracts_lm_policies_awaiting_overdue); 1С:УСК обычно отвечает в течение часа.
# LM_POLICY_REQUEST_AWAITING_INTERVAL=<например 1m>
# LM_POLICY_REQUEST_AWAITING_THRESHOLD=<например 1h>

# --- Передача оплаченных договоров КМ в 1С:УСК (переменные сервиса) ------------------
# Пауза между проходами, которые готовят передачи оплаченных договоров КМ, и размер пачки одного прохода.
# KM_CONTRACT_SUBMISSION_INTERVAL=<например 10s>
# KM_CONTRACT_SUBMISSION_BATCH_SIZE=<число договоров>
# Пауза между пересчётами сводки договоров КМ, ждущих ответа 1С:УСК, и порог просрочки
# (метрика contracts_km_contracts_awaiting_overdue).
# KM_CONTRACT_SUBMISSION_AWAITING_INTERVAL=<например 1m>
# KM_CONTRACT_SUBMISSION_AWAITING_THRESHOLD=<например 1h>

# --- Журнал исходящих сообщений: ответы сервису Заявок (переменные сервиса) -----------
# Пауза между проходами публикатора и размер пачки одного прохода.
# OUTBOX_PUBLISHING_INTERVAL=<например 5s>
# OUTBOX_PUBLISHING_BATCH_SIZE=<число сообщений>
# Сколько ждать подтверждения брокера по одному сообщению; молчание дольше — отложить до повтора.
# OUTBOX_CONFIRM_TIMEOUT=<например 10s>
# Паузы перед повторами после отказа или молчания брокера, через запятую; число пауз — число повторов, после
# последней сообщение отклоняется окончательно. Возврат немаршрутизируемого сообщения не повторяется.
# OUTBOX_RETRY_BACKOFF=<например 1m,5m,15m>
# Через сколько после создания записи стирается тело опубликованного или отклонённого сообщения; запись остаётся.
# OUTBOX_PAYLOAD_RETENTION=<например 30d>
# OUTBOX_RETENTION_INTERVAL=<например 1h>
# OUTBOX_RETENTION_BATCH_SIZE=<число тел в одной транзакции>

# --- Межсервисный брокер контура, сервис Заявок (переменные сервиса) -----------------
# Пароль обязателен вне compose, умолчания нет. Локальный брокер из compose слушает 5674.
# RABBITMQ_INTERNAL_HOST=<хост брокера>
# RABBITMQ_INTERNAL_PORT=<5672 без TLS | 5671 с TLS>
# RABBITMQ_INTERNAL_VHOST=<vhost>
# RABBITMQ_INTERNAL_USERNAME=<логин брокера>
# RABBITMQ_INTERNAL_PASSWORD=<пароль брокера>
# RABBITMQ_INTERNAL_SSL_ENABLED=<true | false>
# Проверка сертификата брокера и имени хоста в нём, умолчание true: центр сертификации — в certs/ (Dockerfile),
# имя хоста — в сертификате. Тестовый контур с самоподписанным сертификатом выключает проверку сертификата явно;
# без неё имя хоста не сверяется.
# RABBITMQ_INTERNAL_SSL_VALIDATE_CERTIFICATE=<true | false>
# RABBITMQ_INTERNAL_SSL_VERIFY_HOSTNAME=<true | false>
# Слушатели очередей сервиса Заявок: потребителей запускает ведущий экземпляр, получив роль. В application.yml
# умолчание true; локальный брокер очередей не знает, поэтому для профиля app compose подставляет false, пока здесь
# не задано иначе.
# RABBITMQ_INTERNAL_LISTENER_AUTO_STARTUP=<true | false>
# Имена очередей — умолчания application.yml из документа контура; менять только по списку брокера.
# INTERNAL_QUEUE_TASK_CHANGES=<очередь задач на выпуск и их отмен>
# INTERNAL_QUEUE_STATUS_CHANGES=<очередь состояния выпуска>

# --- Брокер 1С:УСК (переменные сервиса) ---------------------------------------------
# Те же правила, что у межсервисного брокера. Локальный брокер 1С из compose слушает 5675.
# RABBITMQ_ONEC_HOST=<хост брокера>
# RABBITMQ_ONEC_PORT=<5672 без TLS | 5671 с TLS>
# RABBITMQ_ONEC_VHOST=<vhost>
# RABBITMQ_ONEC_USERNAME=<логин брокера>
# RABBITMQ_ONEC_PASSWORD=<пароль брокера>
# RABBITMQ_ONEC_SSL_ENABLED=<true | false>
# RABBITMQ_ONEC_SSL_VALIDATE_CERTIFICATE=<true | false>
# RABBITMQ_ONEC_SSL_VERIFY_HOSTNAME=<true | false>
# RABBITMQ_ONEC_LISTENER_AUTO_STARTUP=<true | false>
# ONEC_QUEUE_KM_CONTRACT_SUBMISSIONS=<очередь оплаченных договоров КМ в 1С>
# ONEC_QUEUE_KM_CONTRACT_REGISTRATIONS=<очередь результатов регистрации КМ из 1С>
# ONEC_QUEUE_LM_POLICY_REQUESTS=<очередь запросов полисов ЛМ в 1С>
# ONEC_QUEUE_LM_POLICY_ISSUES=<очередь выпущенных полисов ЛМ из 1С>

# --- Оплата через сервис управления заказами (переменные сервиса) -------------------
# Выключатель обязателен и без умолчания: сервис не стартует, пока он не задан. В compose умолчание — false.
# false — заказы на оплату не создаются, настройки ниже не нужны. true — обязательны адреса Ordering и сервера
# токенов, код продукта и канал, клиент сервера токенов и брокер маркетинга с обменником и очередью событий.
# Выключать оплату нельзя, пока есть счета без итога (docs/operations.md).
# PAYMENT_ENABLED=<true | false>
# ORDERING_URL=<https://хост/путь — базовый адрес REST сервиса управления заказами, без / в конце>
# ORDERING_CONNECT_TIMEOUT=<например 2s>
# ORDERING_READ_TIMEOUT=<например 10s>
# Коды продукта и канала выдаёт команда сервиса управления заказами.
# ORDERING_PRODUCT=<код продукта>
# ORDERING_CHANNEL=<код канала>
# ORDERING_CANCEL_REASON=<причина отмены из перечня сервиса управления заказами, по умолчанию notActual>
# ORDERING_ATTEMPTS=<попыток за проход при временном отказе, считая первую>
# ORDERING_RETRY_DELAY=<пауза между попытками, например 1s>
# ORDERING_DOCUMENT_ZONE=<часовой пояс дат документа, например Europe/Moscow>
# ORDERING_DOCUMENT_TTL_BEFORE_CHECK_IN=<насколько раньше начала дня заезда кончается срок документа, например 1s>
# Секрет клиента — только в секретах развёртывания.
# ORDERING_TOKEN_URI=<https://хост/realms/<realm>/protocol/openid-connect/token>
# ORDERING_TOKEN_CLIENT_ID=<клиент сервера токенов>
# ORDERING_TOKEN_CLIENT_SECRET=<секрет клиента сервера токенов>
# ORDERING_TOKEN_CONNECT_TIMEOUT=<например 2s>
# ORDERING_TOKEN_READ_TIMEOUT=<например 5s>
# PAYMENT_ORDER_CREATION_INTERVAL=<пауза между проходами создания заказов, например 10s>
# PAYMENT_ORDER_CANCELLATION_INTERVAL=<пауза между проходами отмены заказов, например 1m>
# PAYMENT_ORDER_BATCH_SIZE=<заказов за проход>
# PAYMENT_ORDER_AWAITING_INTERVAL=<пересчёт сводки договоров без заказа, например 1m>
# PAYMENT_ORDER_AWAITING_THRESHOLD=<сколько договор может ждать заказа, например 1h>
# PAYMENT_INVOICE_CHECKOUT_INTERVAL=<пауза между проходами выставления счетов, например 10s>
# PAYMENT_TERM=<срок оплаты счёта, например 72h; дальше границы накануне заезда срок не уходит>
# PAYMENT_MIN_TERM=<наименьший срок оплаты, например 1h: меньше до границы — счёт не выставляется, договор прекращается>
# PAYMENT_INVOICE_AWAITING_THRESHOLD=<сколько договор с заказом может ждать счёта, например 30m>
# PAYMENT_RECONCILIATION_INTERVAL=<пауза между проходами сверки заказов, например 1m>
# PAYMENT_RECONCILIATION_THRESHOLD=<сколько заказ без итога оплаты не меняется до запроса его состояния, например 15m>
# PAYMENT_OVERDUE_GRACE=<запас после срока оплаты до оповещения и закрытия счёта с ошибкой оплаты, например 1h>
# PAYMENT_DOCUMENT_FIX_REPEATS=<сколько раз сверка повторяет подтверждение документа>
# PAYMENT_SUMMARY_INTERVAL=<пересчёт сводок счетов, например 1m>

# --- Брокер маркетинга (переменные сервиса, только при PAYMENT_ENABLED=true) -------
# Те же правила, что у межсервисного брокера. Локальный брокер маркетинга из compose слушает 5676.
# Учётной записи нужны право публикации в обменник продукта и право чтения очереди событий заказов; обменник и
# очередь заводит сервис управления заказами.
# RABBITMQ_MARKETING_HOST=<хост брокера>
# RABBITMQ_MARKETING_PORT=<5672 без TLS | 5671 с TLS>
# RABBITMQ_MARKETING_VHOST=<vhost>
# RABBITMQ_MARKETING_USERNAME=<логин брокера>
# RABBITMQ_MARKETING_PASSWORD=<пароль брокера>
# RABBITMQ_MARKETING_SSL_ENABLED=<true | false>
# RABBITMQ_MARKETING_SSL_VALIDATE_CERTIFICATE=<true | false>
# RABBITMQ_MARKETING_SSL_VERIFY_HOSTNAME=<true | false>
# MARKETING_DOCUMENT_FIXES_EXCHANGE=<обменник продукта: <код продукта>.exchange>
# MARKETING_DOCUMENT_FIXES_ROUTING_KEY=<ключ подтверждения документа: <код продукта>-contract-fixed>
# MARKETING_ORDER_EVENTS_QUEUE=<очередь событий заказов продукта: order.event.<код продукта>.topic>
# RABBITMQ_MARKETING_LISTENER_AUTO_STARTUP=<true | false>

# --- Доступ с других машин (переменные docker-compose.yml) ---------------------------
# 0.0.0.0 открывает API (8082) и базу (5433) всей сети; пароль базы в compose известен всем — смените его.
# Брокеры и актуатор всегда остаются на 127.0.0.1.
# SERVICE_BIND_ADDRESS=<127.0.0.1 | 0.0.0.0>
# POSTGRES_BIND_ADDRESS=<127.0.0.1 | 0.0.0.0>

# --- Порт актуатора (переменная сервиса) ------------------------------------------
# Порт health, info и prometheus внутри контейнера; на порту API актуатора нет, там только пробы /livez и /readyz.
# Снаружи compose публикует его как 8083 независимо от значения здесь.
# MANAGEMENT_PORT=<порт>

# --- Сборка образа (аргументы Dockerfile) ------------------------------------------
# host — взять jar из build/libs после ./gradlew bootJar, когда у сборки образа нет сети.
# JAR_SOURCE=<build | host>
# true — зависимости из Maven Central вместо Nexus контура.
# PUBLIC_REPOSITORIES=<true | false>
# JDK_IMAGE=<реестр/eclipse-temurin:21.0.12.1_1-jdk>
# JRE_IMAGE=<реестр/eclipse-temurin:21.0.12.1_1-jre>
# Полный адрес -bin.zip в зеркале одной строкой: обёртка сверяет архив с distributionSha256Sum.
# GRADLE_DISTRIBUTION_URL=https://<зеркало>/gradle-8.14.3-bin.zip
